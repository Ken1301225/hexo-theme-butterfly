$indexLayout = hexo-config('index_layout') || 1
$indexEnable = hexo-config('cover.index_enable')

#recent-posts
  .recent-post-item
    @extend .cardHover
    position: relative
    overflow: hidden
    margin-bottom: 20px

    if $indexLayout == 6 || ($indexLayout == 7)
      display: inline-block
      width: calc(100% / 2 - 8px)
      vertical-align: top

      +maxWidth768()
        width: 100%

      +minWidth2000()
        width: calc(100% / 3 - 8px)

    if $indexLayout == 1 || ($indexLayout == 2 || ($indexLayout == 3))
      display: flex
      flex-direction: row
      align-items: center
      height: 16.8em

      +maxWidth768()
        flex-direction: column
        height: auto

      +minWidth2000()
        height: 18.8em

    &:hover
      .post-bg
        transform: scale(1.1)

    &.ads-wrap
      display: block !important
      height: auto !important

    .post_cover
      overflow: hidden

      if ($indexLayout != 5 && ($indexLayout != 7))
        +maxWidth768()
          width: 100%
          height: 230px

      if $indexLayout == 1 || ($indexLayout == 2 || ($indexLayout == 3))
        width: 42%
        height: 100%

        &.right
          order: 1

          +maxWidth768()
            order: 0

      if $indexLayout == 4 || ($indexLayout == 5 || ($indexLayout == 6 || ($indexLayout == 7)))
        width: 100%

        if ($indexLayout == 5 || ($indexLayout == 7))
          height: 17em
        else
          height: 230px

      if ($indexLayout == 5 || ($indexLayout == 7)) && $indexEnable
        &:before
          position: absolute
          z-index: 1
          width: 100%
          height: 100%
          background-color: rgba(18, 18, 18, .4)
          content: ''
          backdrop-filter: blur(3px)

      .post-bg
        z-index: -4
        @extend .imgHover

    & >.recent-post-info
      +maxWidth768()
        padding: 20px 20px 30px
        width: 100%

      if $indexLayout == 1 || ($indexLayout == 2 || ($indexLayout == 3))
        padding: 0 40px
        width: 58%

      if $indexLayout == 4 || ($indexLayout == 5 || ($indexLayout == 6 || ($indexLayout == 7)))
        padding: 30px 30px 25px

      if ($indexLayout == 5 || ($indexLayout == 7)) && $indexEnable
        &:not(.no-cover)
          position: absolute
          top: 50%
          z-index: 2
          width: 100%
          color: var(--text-highlight-color)
          transform: translateY(-50%)
          --text-highlight-color: rgba(255, 255, 255, 1)
          --card-meta: rgba(255, 255, 255, .7)

      &.no-cover
        +maxWidth768()
          padding: 30px 20px

        if $indexLayout == 1 || ($indexLayout == 2 || ($indexLayout == 3))
          width: 100%

        if $indexLayout == 4 || ($indexLayout == 5 || ($indexLayout == 6 || ($indexLayout == 7)))
          padding: 35px 30px

      & > .article-title
        @extend .limit-more-line
        color: var(--text-highlight-color)
        font-size: 1.55em
        line-height: 1.4
        transition: all .2s ease-in-out
        -webkit-line-clamp: 2

        .sticky
          margin-right: 10px
          color: $sticky-color
          transform: rotate(45deg)

        +maxWidth768()
          font-size: 1.43em

        &:hover
          color: $text-hover

      & > .article-meta-wrap
        margin: 6px 0
        color: var(--card-meta)
        font-size: .9em

        & > .post-meta-date
          cursor: default

        i
          margin: 0 4px 0 0

        .fa-spinner
          margin: 0

        .article-meta-label
          if hexo-config('post_meta.page.label')
            padding-right: 4px
          else
            display: none

        .article-meta-separator
          margin: 0 6px

        .article-meta-link
          margin: 0 4px

        if hexo-config('post_meta.page.date_format') == 'relative'
          time
            display: none

        a
          color: var(--card-meta)

          &:hover
            color: $text-hover
            text-decoration: underline

      & > .content
        @extend .limit-more-line
        -webkit-line-clamp: 2
        word-break: break-word

.home-frontpage
  box-sizing: border-box
  width: 100%
  min-width: 0
  overflow: hidden

  +maxWidth768()
    padding: 0 6px

  .home-overview
    display: grid
    grid-template-columns: minmax(0, 1.1fr) minmax(0, .95fr) minmax(0, .95fr)
    gap: 20px
    margin-bottom: 20px

    +maxWidth900()
      grid-template-columns: 1fr

    +maxWidth768()
      grid-template-columns: 1fr

  .home-panel
    @extend .cardHover
    box-sizing: border-box
    min-width: 0
    padding: 20px 24px

  .home-update-card
    overflow: hidden

  .home-panel-head
    display: flex
    align-items: center
    gap: 8px
    margin-bottom: 12px
    color: var(--text-highlight-color)
    font-size: 1.12em
    font-weight: 600

    i
      color: $theme-color

  .home-update-summary
    display: flex
    justify-content: space-between
    margin-bottom: 12px
    color: var(--card-meta)
    font-size: .88em

  .home-update-calendar
    display: grid
    width: 100%
    max-width: 100%
    aspect-ratio: 12 / 7
    grid-template-rows: repeat(7, minmax(0, 1fr))
    grid-template-columns: repeat(12, minmax(0, 1fr))
    grid-auto-flow: column
    gap: 4px
    min-height: 0

  .home-update-day
    display: block
    min-width: 0
    min-height: 0
    border-radius: 2px
    background: alpha($grey, .16)

    &.level-1
      background: alpha($theme-color, .28)

    &.level-2
      background: alpha($theme-color, .58)

    &.level-3
      background: $theme-color

  .home-update-legend
    display: flex
    align-items: center
    justify-content: flex-end
    gap: 5px
    margin-top: 10px
    color: var(--card-meta)
    font-size: .78em

    .home-update-day
      width: 10px
      height: 10px
      min-width: 10px
      aspect-ratio: auto

  .home-plan-list
    display: grid
    gap: 12px

  .home-plan-item
    padding-bottom: 10px
    border-bottom: 1px dashed var(--hr-border)

    &:last-child
      border-bottom: 0

  .home-plan-title
    color: var(--text-highlight-color)
    font-weight: 600
    line-height: 1.45

  .home-plan-meta
    display: flex
    gap: 8px
    margin-top: 3px
    color: var(--card-meta)
    font-size: .82em

  .home-plan-steps,
  .home-todo-list
    margin: 8px 0 0
    padding: 0
    list-style: none

  .home-plan-steps
    li
      position: relative
      padding-left: 14px
      color: var(--font-color)
      font-size: .92em
      line-height: 1.7

      &:before
        position: absolute
        top: .72em
        left: 0
        width: 5px
        height: 5px
        border-radius: 50%
        background: $theme-color
        content: ''

  .home-todo-list
    display: grid
    gap: 7px

    li
      display: flex
      align-items: flex-start
      gap: 8px
      color: var(--font-color)
      line-height: 1.55

      i
        margin-top: .24em
        color: $theme-color

      &.done
        color: var(--card-meta)
        text-decoration: line-through

  .home-announcement-list
    overflow-y: auto
    max-height: 230px
    padding-right: 4px

  .home-announcement-item
    padding: 10px 0

    &:first-child
      padding-top: 0

    &:not(:last-child)
      border-bottom: 1px dashed var(--hr-border)

  .home-announcement-link
    display: block
    color: var(--font-color)

    &:hover
      color: $text-hover

  .home-announcement-date
    display: block
    margin-bottom: 4px
    color: var(--card-meta)
    font-size: .78em

  .home-announcement-title
    color: var(--text-highlight-color)
    font-weight: 600
    line-height: 1.45

  .home-announcement-content
    margin-top: 4px
    color: var(--font-color)
    font-size: .92em
    line-height: 1.65

  .home-empty-state
    @extend .cardHover
    display: flex
    align-items: center
    justify-content: center
    gap: 8px
    min-height: 120px
    color: var(--card-meta)

  .home-frontpage-bar
    @extend .cardHover
    display: grid
    grid-template-columns: 1fr auto 1fr
    align-items: end
    gap: 14px
    margin-bottom: 20px
    padding: 22px 24px

    +maxWidth768()
      grid-template-columns: 1fr
      text-align: center

    h1
      margin: 0
      color: var(--text-highlight-color)
      text-align: center
      font-size: clamp(2.2em, 5vw, 4.5em)
      line-height: .95
      letter-spacing: 0

  .home-github-link
    color: var(--text-highlight-color)
    text-align: center

    &:hover
      color: $text-hover

  .home-frontpage-kicker,
  .home-frontpage-date,
  .home-article-kind,
  .home-read-more,
  .home-frontpage-actions
    color: var(--card-meta)
    font-size: .78em
    font-weight: 700
    letter-spacing: .04em
    text-transform: uppercase

  .home-frontpage-date
    text-align: right

    +maxWidth768()
      text-align: center

  .home-section-title
    display: flex
    align-items: center
    justify-content: space-between
    margin-bottom: 14px
    padding-bottom: 8px
    border-bottom: 1px solid var(--hr-border)
    color: var(--text-highlight-color)
    font-size: 1.35em
    font-weight: 700
    text-transform: uppercase

    a
      color: var(--card-meta)
      font-size: .58em
      text-transform: none

      &:hover
        color: $text-hover

  .home-spotlight-grid
    display: grid
    grid-template-columns: minmax(0, 1.35fr) minmax(260px, .85fr)
    gap: 20px

    +maxWidth768()
      grid-template-columns: 1fr

  .home-spotlight-main,
  .home-frontpage-item
    @extend .cardHover
    padding: 20px 24px

  .home-spotlight-cover
    display: flex
    align-items: center
    justify-content: center
    overflow: hidden
    margin: -20px -24px 16px
    aspect-ratio: 16 / 10
    background: var(--text-bg-hover)
    color: var(--card-meta)

    img,
    .home-cover-bg
      width: 100%
      height: 100%
      object-fit: cover
      transition: transform .3s

    .home-cover-bg
      background-size: cover !important
      background-position: center !important

    i
      font-size: 3em

    &:hover
      img,
      .home-cover-bg
        transform: scale(1.04)

  .home-spotlight-title
    display: block
    margin: 6px 0 8px
    color: var(--text-highlight-color)
    font-size: 1.65em
    font-weight: 700
    line-height: 1.32

    &:hover
      color: $text-hover

    +maxWidth768()
      font-size: 1.42em

  .home-article-meta
    display: flex
    flex-wrap: wrap
    gap: 8px 12px
    color: var(--card-meta)
    font-size: .86em

    i
      margin-right: 4px

  .home-article-excerpt
    @extend .limit-more-line
    margin-top: 10px
    color: var(--font-color)
    line-height: 1.8
    -webkit-line-clamp: 3

  .home-read-more
    display: inline-block
    margin-top: 12px

    &:hover
      color: $text-hover

  .home-spotlight-list
    display: grid
    gap: 14px

  .home-frontpage-item
    padding: 16px 18px

  .home-frontpage-item-title
    @extend .limit-more-line
    display: block
    margin: 4px 0 8px
    color: var(--text-highlight-color)
    font-weight: 700
    line-height: 1.45
    -webkit-line-clamp: 2

    &:hover
      color: $text-hover

  .home-frontpage-actions
    display: flex
    justify-content: space-between
    gap: 12px
    margin-top: 20px

    +maxWidth768()
      flex-direction: column

    a
      display: inline-flex
      align-items: center
      justify-content: center
      gap: 8px
      min-height: 38px
      padding: 0 16px
      border: 1px solid var(--hr-border)
      color: var(--font-color)
      addBorderRadius(8)

      &:hover
        border-color: $theme-color
        color: $text-hover

.posts-list-page
  #recent-posts
    width: 100%
