$indexLayout = hexo-config('index_layout') || 1
$indexEnable = hexo-config('cover.index_enable')

#recent-posts
  .recent-post-item
    @extend .cardHover
    position: relative
    overflow: hidden
    margin-bottom: 20px

    if $indexLayout == 6 || ($indexLayout == 7)
      display: inline-block
      width: calc(100% / 2 - 8px)
      vertical-align: top

      +maxWidth768()
        width: 100%

      +minWidth2000()
        width: calc(100% / 3 - 8px)

    if $indexLayout == 1 || ($indexLayout == 2 || ($indexLayout == 3))
      display: flex
      flex-direction: row
      align-items: center
      height: 16.8em

      +maxWidth768()
        flex-direction: column
        height: auto

      +minWidth2000()
        height: 18.8em

    &:hover
      .post-bg
        transform: scale(1.1)

    &.ads-wrap
      display: block !important
      height: auto !important

    .post_cover
      overflow: hidden

      if ($indexLayout != 5 && ($indexLayout != 7))
        +maxWidth768()
          width: 100%
          height: 230px

      if $indexLayout == 1 || ($indexLayout == 2 || ($indexLayout == 3))
        width: 42%
        height: 100%

        &.right
          order: 1

          +maxWidth768()
            order: 0

      if $indexLayout == 4 || ($indexLayout == 5 || ($indexLayout == 6 || ($indexLayout == 7)))
        width: 100%

        if ($indexLayout == 5 || ($indexLayout == 7))
          height: 17em
        else
          height: 230px

      if ($indexLayout == 5 || ($indexLayout == 7)) && $indexEnable
        &:before
          position: absolute
          z-index: 1
          width: 100%
          height: 100%
          background-color: rgba(18, 18, 18, .4)
          content: ''
          backdrop-filter: blur(3px)

      .post-bg
        z-index: -4
        @extend .imgHover

    & >.recent-post-info
      +maxWidth768()
        padding: 20px 20px 30px
        width: 100%

      if $indexLayout == 1 || ($indexLayout == 2 || ($indexLayout == 3))
        padding: 0 40px
        width: 58%

      if $indexLayout == 4 || ($indexLayout == 5 || ($indexLayout == 6 || ($indexLayout == 7)))
        padding: 30px 30px 25px

      if ($indexLayout == 5 || ($indexLayout == 7)) && $indexEnable
        &:not(.no-cover)
          position: absolute
          top: 50%
          z-index: 2
          width: 100%
          color: var(--text-highlight-color)
          transform: translateY(-50%)
          --text-highlight-color: rgba(255, 255, 255, 1)
          --card-meta: rgba(255, 255, 255, .7)

      &.no-cover
        +maxWidth768()
          padding: 30px 20px

        if $indexLayout == 1 || ($indexLayout == 2 || ($indexLayout == 3))
          width: 100%

        if $indexLayout == 4 || ($indexLayout == 5 || ($indexLayout == 6 || ($indexLayout == 7)))
          padding: 35px 30px

      & > .article-title
        @extend .limit-more-line
        color: var(--text-highlight-color)
        font-size: 1.55em
        line-height: 1.4
        transition: all .2s ease-in-out
        -webkit-line-clamp: 2

        .sticky
          margin-right: 10px
          color: $sticky-color
          transform: rotate(45deg)

        +maxWidth768()
          font-size: 1.43em

        &:hover
          color: $text-hover

      & > .article-meta-wrap
        margin: 6px 0
        color: var(--card-meta)
        font-size: .9em

        & > .post-meta-date
          cursor: default

        i
          margin: 0 4px 0 0

        .fa-spinner
          margin: 0

        .article-meta-label
          if hexo-config('post_meta.page.label')
            padding-right: 4px
          else
            display: none

        .article-meta-separator
          margin: 0 6px

        .article-meta-link
          margin: 0 4px

        if hexo-config('post_meta.page.date_format') == 'relative'
          time
            display: none

        a
          color: var(--card-meta)

          &:hover
            color: $text-hover
            text-decoration: underline

      & > .content
        @extend .limit-more-line
        -webkit-line-clamp: 2
        word-break: break-word

:root
  --home-scroll-progress: 0

#page-header.full_page + #content-inner
  position: relative
  z-index: 2
  margin-top: -32px
  padding: clamp(64px, 8vw, 104px) 15px 72px
  max-width: none
  border-radius: 32px 32px 0 0
  background: var(--editorial-surface)
  box-shadow: 0 -24px 70px rgba(6, 13, 34, .16)
  filter: unquote('opacity(calc(.82 + var(--home-scroll-progress) * .18))')
  transform: translateY(calc((1 - var(--home-scroll-progress)) * 32px))
  transform-origin: top center
  will-change: transform, opacity

  +maxWidth768()
    margin-top: -20px
    padding: 44px 5px 52px
    border-radius: 20px 20px 0 0
    transform: translateY(calc((1 - var(--home-scroll-progress)) * 20px))

.home-frontpage
  --home-module-surface: #f4f5f7
  --home-module-shadow: 0 10px 28px rgba(23, 32, 51, .08), 0 2px 6px rgba(23, 32, 51, .035)
  --home-module-hover-shadow: 0 16px 36px rgba(23, 32, 51, .12), 0 3px 9px rgba(23, 32, 51, .05)
  box-sizing: border-box
  width: 100%
  max-width: 1000px
  min-width: 0
  margin: 0 auto
  overflow: hidden

  +maxWidth768()
    padding: 0 6px

  .home-overview
    display: grid
    grid-template-columns: minmax(0, 1.1fr) minmax(0, .95fr) minmax(0, .95fr)
    gap: 20px
    margin-bottom: 20px

    +maxWidth900()
      grid-template-columns: 1fr

    +maxWidth768()
      grid-template-columns: 1fr

  .home-panel
    @extend .cardHover
    box-sizing: border-box
    min-width: 0
    padding: 20px 24px
    border: 1px solid var(--editorial-border)
    background: var(--home-module-surface)
    box-shadow: var(--home-module-shadow)

    &:hover
      box-shadow: var(--home-module-hover-shadow)

  .home-update-card
    overflow: hidden

  .home-panel-head
    display: flex
    align-items: center
    gap: 8px
    margin-bottom: 12px
    color: var(--editorial-ink)
    font-size: 1.12em
    font-weight: 600

    i
      color: #374476

  .home-update-summary
    display: flex
    justify-content: space-between
    margin-bottom: 12px
    color: var(--editorial-meta)
    font-size: .88em

  .home-update-calendar
    display: grid
    width: 100%
    max-width: 100%
    aspect-ratio: 12 / 7
    grid-template-rows: repeat(7, minmax(0, 1fr))
    grid-template-columns: repeat(12, minmax(0, 1fr))
    grid-auto-flow: column
    gap: 4px
    min-height: 0

  .home-update-day
    display: block
    min-width: 0
    min-height: 0
    border-radius: 2px
    background: #eef1f6
    box-shadow: inset 0 0 0 1px #e5e9f0

    &.level-1
      background: #c9d1e3

    &.level-2
      background: #7f8db5

    &.level-3
      background: #374476

  .home-update-legend
    display: flex
    align-items: center
    justify-content: flex-end
    gap: 5px
    margin-top: 10px
    color: var(--card-meta)
    font-size: .78em

    .home-update-day
      width: 10px
      height: 10px
      min-width: 10px
      aspect-ratio: auto

  .home-plan-list
    display: grid
    gap: 12px

  .home-plan-item
    padding-bottom: 10px
    border-bottom: 1px dashed var(--hr-border)

    &:last-child
      border-bottom: 0

  .home-plan-title
    color: var(--text-highlight-color)
    font-weight: 600
    line-height: 1.45

  .home-plan-meta
    display: flex
    gap: 8px
    margin-top: 3px
    color: var(--editorial-meta)
    font-size: .82em

  .home-plan-steps,
  .home-todo-list
    margin: 8px 0 0
    padding: 0
    list-style: none

  .home-plan-steps
    li
      position: relative
      padding-left: 14px
      color: var(--font-color)
      font-size: .92em
      line-height: 1.7

      &:before
        position: absolute
        top: .72em
        left: 0
        width: 5px
        height: 5px
        border-radius: 50%
        background: $theme-color
        content: ''

  .home-todo-list
    display: grid
    gap: 7px

    li
      display: flex
      align-items: flex-start
      gap: 8px
      color: var(--font-color)
      line-height: 1.55

      i
        margin-top: .24em
        color: $theme-color

      &.done
        color: var(--card-meta)
        text-decoration: line-through

  .home-announcement-list
    overflow-y: auto
    max-height: 230px
    padding-right: 4px

  .home-announcement-item
    padding: 10px 0

    &:first-child
      padding-top: 0

    &:not(:last-child)
      border-bottom: 1px dashed var(--hr-border)

  .home-announcement-link
    display: block
    color: var(--font-color)

    &:hover
      color: $text-hover

  .home-announcement-date
    display: block
    margin-bottom: 4px
    color: var(--editorial-meta)
    font-size: .78em

  .home-announcement-title
    color: var(--text-highlight-color)
    font-weight: 600
    line-height: 1.45

  .home-announcement-content
    margin-top: 4px
    color: var(--font-color)
    font-size: .92em
    line-height: 1.65

  .home-empty-state
    @extend .cardHover
    display: flex
    align-items: center
    justify-content: center
    gap: 8px
    min-height: 120px
    color: var(--card-meta)

  .home-article-kind,
  .home-read-more,
  .home-frontpage-actions
    color: var(--card-meta)
    font-size: .78em
    font-weight: 700
    letter-spacing: .04em
    text-transform: uppercase

  .home-section-title
    display: flex
    align-items: center
    gap: 16px
    margin-bottom: 20px
    color: var(--editorial-ink)
    font-size: 1.15em
    font-weight: 700
    letter-spacing: .18em
    text-transform: uppercase
    text-shadow: none

    &:before,
    &:after
      height: 1px
      background: var(--editorial-border)
      content: ''

    &:before
      flex: 0 0 24px

    &:after
      flex: 1 1 0

    a
      flex: 0 0 auto
      color: var(--editorial-meta)
      font-size: .62em
      letter-spacing: .04em
      text-transform: none
      transition: color .2s

      &:hover
        color: #0a1b58

  .home-spotlight-grid
    display: grid
    grid-template-columns: minmax(0, 1.35fr) minmax(260px, .85fr)
    gap: 20px

    +maxWidth768()
      grid-template-columns: 1fr

  .home-spotlight-main,
  .home-frontpage-item
    @extend .cardHover
    padding: 20px 24px
    border: 1px solid var(--editorial-border)
    background: var(--home-module-surface)
    box-shadow: var(--home-module-shadow)

    &:hover
      box-shadow: var(--home-module-hover-shadow)

  .home-spotlight-main
    overflow: hidden
    border-radius: 8px

  .home-spotlight-cover
    display: flex
    align-items: center
    justify-content: center
    overflow: hidden
    margin: -20px -24px 16px
    aspect-ratio: 16 / 10
    border-radius: 8px 8px 0 0
    background: var(--text-bg-hover)
    color: var(--card-meta)

    img,
    .home-cover-bg
      width: 100%
      height: 100%
      object-fit: cover
      transition: transform .3s

    .home-cover-bg
      background-size: cover !important
      background-position: center !important

    i
      font-size: 3em

    &:hover
      img,
      .home-cover-bg
        transform: scale(1.04)

  .home-spotlight-title
    display: block
    margin: 6px 0 8px
    color: var(--text-highlight-color)
    font-size: 1.65em
    font-weight: 700
    line-height: 1.32

    &:hover
      color: $text-hover

    +maxWidth768()
      font-size: 1.42em

  .home-article-meta
    display: flex
    flex-wrap: wrap
    align-items: center
    gap: 6px 14px
    color: var(--card-meta)
    font-size: .86em
    line-height: 1.4

    .home-meta-item
      display: inline-flex
      align-items: center
      gap: 7px
      min-width: 0

      i
        flex: 0 0 1.15em
        width: 1.15em
        margin: 0
        text-align: center
        line-height: 1

      span,
      time
        line-height: 1.4

  .home-article-excerpt
    @extend .limit-more-line
    margin-top: 10px
    color: var(--font-color)
    line-height: 1.8
    -webkit-line-clamp: 3

  .home-read-more
    display: inline-block
    margin-top: 12px

    &:hover
      color: $text-hover

  .home-spotlight-list
    display: grid
    grid-auto-rows: 1fr
    gap: 14px

  .home-frontpage-item
    display: flex
    flex-direction: column
    justify-content: center
    padding: 16px 18px

  .home-frontpage-item-title
    @extend .limit-more-line
    display: block
    margin: 4px 0 8px
    color: var(--text-highlight-color)
    font-weight: 700
    line-height: 1.45
    -webkit-line-clamp: 2

    &:hover
      color: $text-hover

  .home-frontpage-actions
    display: flex
    justify-content: center
    gap: 12px
    margin-top: 24px

    a
      display: inline-flex
      align-items: center
      justify-content: center
      gap: 10px
      min-height: 42px
      padding: 0 28px
      border: 1px solid #374476
      background: transparent
      color: #374476
      addBorderRadius(21)
      transition: border-color .2s, background .2s, color .2s

      &:hover
        border-color: #0a1b58
        background: #0a1b58
        color: #fff

.posts-list-page
  #recent-posts
    box-sizing: border-box
    padding: 0 0 1px
    width: 100%
    background: transparent

    +maxWidth768()
      padding: 0 6px 1px

#body-wrap.type-posts
  background: transparent

  #content-inner
    background: transparent

  #page
    background: transparent

// home hero masthead: kicker + enlarged title + date + social icons
#page-header.full_page
  #site-info
    .site-kicker
      margin-bottom: 10px
      color: rgba(255, 255, 255, .72)
      font-size: .78em
      font-weight: 700
      letter-spacing: .34em
      text-align: center
      text-indent: .34em
      text-transform: uppercase
      text-shadow: 0 1px 8px rgba(7, 20, 58, .28)

  #site-title
    font-size: clamp(2.6em, 5vw, 4em)
    letter-spacing: .06em

  #site-date
    margin-top: 12px
    color: rgba(255, 255, 255, .62)
    font-size: .92em
    letter-spacing: .14em
    text-align: center
    text-indent: .14em
    text-shadow: 0 1px 8px rgba(7, 20, 58, .28)

  #site_social_icons
    display: block
    margin-top: 16px

    .social-icon
      margin: 0 8px
      color: rgba(255, 255, 255, .72)
      font-size: 1.3em
      transition: color .2s

      &:hover
        color: var(--white)

@media (prefers-reduced-motion: reduce)
  #page-header.full_page + #content-inner
    margin-top: 0
    opacity: 1
    filter: none
    transform: none
    will-change: auto
    animation: none

  #page-header.full_page #site-info,
  #page-header.full_page #scroll-down,
  #page-header.full_page #site-title,
  #page-header.full_page #site-subtitle,
  #page-header.full_page .scroll-down-effects
    transition: none
    animation: none
