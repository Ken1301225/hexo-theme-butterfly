#body-wrap
  display: flex
  flex-direction: column
  min-height: 100vh

[data-theme='light']
  body,
  #body-wrap,
  #content-inner
    background: var(--editorial-surface)

  #page,
  #post,
  #archive,
  #tag,
  .posts-list-page #recent-posts > .recent-post-item
    border: 1px solid var(--editorial-border)
    background: var(--editorial-surface)
    box-shadow: 0 12px 34px rgba(23, 32, 51, .05)

  #article-container
    color: #344054

    p,
    li
      color: #344054

    strong,
    b
      color: var(--editorial-ink)

    a
      color: #374476

      &:hover
        color: #0a1b58

.layout
  display: flex
  flex: 1 auto
  box-sizing: border-box
  margin: 0 auto
  padding: 40px 15px
  max-width: 1200px
  width: 100%

  +maxWidth900()
    flex-direction: column

  +maxWidth768()
    padding: 20px 5px

  +minWidth2000()
    max-width: 60%

  & > div:first-child:not(.nc)
    @extend .cardHover
    align-self: flex-start
    padding: 50px 40px

    +maxWidth768()
      padding: 36px 14px

  & > div:first-child
    width: 74%
    transition: all .3s

    +maxWidth900()
      width: 100% !important

    if hexo-config('aside.position') == 'left'
      +minWidth900()
        order: 2

  // 隱藏aside
  &.hide-aside
    max-width: 1000px

    +minWidth2000()
      max-width: 1300px

    & > div
      width: 100% !important

// for apple device
.apple
  #page-header.full_page
    background-attachment: scroll !important

  .recent-post-item,
  .avatar-img,
  .flink-item-icon
    transform: translateZ(0)
