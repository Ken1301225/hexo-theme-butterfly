.category-lists
  .category-title
    font-size: 2.57em

    +maxWidth768()
      font-size: 2em

  .category-list
    margin-bottom: 0

    a
      color: var(--font-color)

      &:hover
        color: $text-hover

    .category-list-count
      margin-left: 8px
      color: var(--card-meta)

      &:before
        content: '('

      &:after
        content: ')'

  ul
    padding: 0 0 0 20px
    @extend .list-beauty

    ul
      padding-left: 4px

    li
      position: relative
      margin: 6px 0
      padding: .12em .4em .12em 1.4em

.category-overview
  color: var(--font-color)

  &__header
    display: flex
    align-items: center
    margin-bottom: 26px
    padding-bottom: 22px
    border-bottom: 1px solid rgba(55, 68, 118, .14)
    gap: 16px

  &__icon,
  &__folder
    display: inline-flex
    align-items: center
    justify-content: center
    flex: 0 0 auto
    color: $theme-color
    background: rgba(55, 68, 118, .11)

  &__icon
    width: 52px
    height: 52px
    font-size: 1.45em
    addBorderRadius(12)

  &__folder
    width: 48px
    height: 48px
    font-size: 1.25em
    addBorderRadius(50%)

  &__copy
    h2
      margin: 0 0 6px
      color: $theme-color
      font-size: 2em
      line-height: 1.25

      +maxWidth768()
        font-size: 1.65em

    p
      margin: 0
      color: var(--card-meta)
      font-size: .98em

  &__list
    display: grid
    gap: 16px

  &__item
    border: 1px solid var(--editorial-border)
    background: var(--editorial-muted)
    box-shadow: 0 8px 24px rgba(23, 32, 51, .06)
    transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease
    addBorderRadius(8)

    &:hover
      border-color: rgba(55, 68, 118, .26)
      box-shadow: 0 14px 30px rgba(23, 32, 51, .1)
      transform: translateY(-1px)

  &__main,
  &__child
    display: grid
    align-items: center
    color: var(--font-color)
    text-decoration: none

    &:hover
      color: $text-hover

  &__main
    grid-template-columns: 56px minmax(0, 1fr) auto 20px
    padding: 18px 20px
    gap: 14px

    +maxWidth768()
      grid-template-columns: 48px minmax(0, 1fr) auto
      padding: 16px

      .category-overview__arrow
        display: none

  &__name
    overflow: hidden
    color: $theme-color
    font-size: 1.25em
    font-weight: 700
    text-overflow: ellipsis
    white-space: nowrap

  &__count,
  &__child-count
    display: inline-flex
    align-items: baseline
    justify-content: flex-end
    min-width: 76px
    color: var(--card-meta)
    gap: 4px

    strong
      color: $theme-color
      font-size: 1.35em
      line-height: 1

    span
      font-size: .86em

  &__arrow
    color: $theme-color
    font-size: .95em

  &__children
    position: relative
    margin: -4px 14px 14px 84px
    padding: 10px 0 0 16px
    border-left: 2px solid rgba(55, 68, 118, .2)

    +maxWidth768()
      margin-left: 40px

  &__child
    grid-template-columns: minmax(0, 1fr) auto 16px
    margin: 0 0 8px
    padding: 12px 14px
    border: 1px solid rgba(55, 68, 118, .1)
    background: rgba(245, 248, 255, .72)
    gap: 12px
    addBorderRadius(7)

    &:last-child
      margin-bottom: 0

  &__child-name
    overflow: hidden
    color: $theme-color
    font-weight: 700
    text-overflow: ellipsis
    white-space: nowrap

  &__child-count
    min-width: 70px

    strong
      font-size: 1.18em

  &__empty
    padding: 20px
    color: var(--card-meta)
    text-align: center
