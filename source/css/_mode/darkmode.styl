if hexo-config('darkmode.enable') || hexo-config('display_mode') == 'dark'
  [data-theme='dark']
    --global-bg: #060d22
    --font-color: rgba(218, 226, 244, .76)
    --hr-border: rgba(161, 177, 217, .24)
    --hr-before-color: rgba(226, 232, 247, .74)
    --search-bg: #101a33
    --search-input-color: rgba(218, 226, 244, .78)
    --search-a-color: rgba(226, 232, 247, .82)
    --preloader-bg: #060d22
    --preloader-color: rgba(226, 232, 247, .82)
    --tab-border-color: rgba(161, 177, 217, .18)
    --tab-button-bg: #101a33
    --tab-button-color: rgba(218, 226, 244, .72)
    --tab-button-hover-bg: #182744
    --tab-button-active-bg: #0c1730
    --card-bg: #101a33
    --card-meta: rgba(218, 226, 244, .68)
    --editorial-surface: #060d22
    --editorial-muted: #101a33
    --editorial-ink: rgba(246, 248, 255, .94)
    --editorial-meta: rgba(218, 226, 244, .68)
    --editorial-border: rgba(161, 177, 217, .1)
    --sidebar-bg: #081126
    --sidebar-menu-bg: #101a33
    --btn-hover-color: #d8d2c3
    --btn-color: rgba(226, 232, 247, .78)
    --btn-bg: #182744
    --text-bg-hover: #182744
    --light-grey: rgba(226, 232, 247, .76)
    --dark-grey: rgba(161, 177, 217, .28)
    --white: alpha(#FFFFFF, .9)
    --text-highlight-color: rgba(246, 248, 255, .94)
    --blockquote-color: rgba(218, 226, 244, .78)
    --blockquote-bg: rgba(216, 210, 195, .1)
    --reward-pop: #14213f
    --toc-link-color: rgba(218, 226, 244, .62)
    --scrollbar-color: #40577b
    --timeline-bg: #0c1730
    --zoom-bg: #060d22
    --mark-bg: rgba(0, 0, 0, .48)
    --card-box-shadow: 0 18px 42px rgba(0, 0, 0, .28), inset 0 0 0 1px rgba(161, 177, 217, .08)
    --card-hover-box-shadow: 0 22px 52px rgba(0, 0, 0, .36), inset 0 0 0 1px rgba(216, 210, 195, .16)
    --night-accent: #e5decc
    --night-accent-soft: #c9d8d2
    --night-panel: rgba(10, 18, 38, .92)
    --night-panel-soft: rgba(16, 28, 56, .72)
    --night-border: rgba(229, 222, 204, .16)
    --btn-default-color: lighten($btn-default-color, 20%)
    --tags-blue-color: desaturate(darken($tagsP-blue-color, 20%), 25%)
    --tags-blue-color-lighten: rgba(66, 139, 202, .15)
    --tags-pink-color: desaturate(darken($tagsP-pink-color, 22%), 30%)
    --tags-pink-color-lighten: rgba(255, 105, 180, .15)
    --tags-red-color: desaturate(darken($tagsP-red-color, 25%), 28%)
    --tags-red-color-lighten: rgba(255, 0, 0, .15)
    --tags-orange-color: desaturate(darken($tagsP-orange-color, 22%), 32%)
    --tags-orange-color-lighten: rgba(255, 140, 0, .15)
    --tags-purple-color: desaturate(darken($tagsP-purple-color, 18%), 30%)
    --tags-purple-color-lighten: rgba(111, 66, 193, .15)
    --tags-green-color: desaturate(darken($tagsP-green-color, 20%), 28%)
    --tags-green-color-lighten: rgba(92, 184, 92, .15)
    --note-default-border: $note-dark-default-border
    --note-default-bg: $note-dark-default-bg
    --note-default-text: $note-dark-default-text
    --note-modern-default-border: $note-dark-modern-default-border
    --note-modern-default-bg: $note-dark-modern-default-bg
    --note-modern-default-text: $note-dark-modern-default-text
    --note-primary-border: $note-dark-primary-border
    --note-primary-bg: $note-dark-primary-bg
    --note-primary-text: $note-dark-primary-text
    --note-modern-primary-border: $note-dark-modern-primary-border
    --note-modern-primary-bg: $note-dark-modern-primary-bg
    --note-modern-primary-text: $note-dark-modern-primary-text
    --note-info-border: $note-dark-info-border
    --note-info-bg: $note-dark-info-bg
    --note-info-text: $note-dark-info-text
    --note-modern-info-border: $note-dark-modern-info-border
    --note-modern-info-bg: $note-dark-modern-info-bg
    --note-modern-info-text: $note-dark-modern-info-text
    --note-success-border: $note-dark-success-border
    --note-success-bg: $note-dark-success-bg
    --note-success-text: $note-dark-success-text
    --note-modern-success-border: $note-dark-modern-success-border
    --note-modern-success-bg: $note-dark-modern-success-bg
    --note-modern-success-text: $note-dark-modern-success-text
    --note-warning-border: $note-dark-warning-border
    --note-warning-bg: $note-dark-warning-bg
    --note-warning-text: $note-dark-warning-text
    --note-modern-warning-border: $note-dark-modern-warning-border
    --note-modern-warning-bg: $note-dark-modern-warning-bg
    --note-modern-warning-text: $note-dark-modern-warning-text
    --note-danger-border: $note-dark-danger-border
    --note-danger-bg: $note-dark-danger-bg
    --note-danger-text: $note-dark-danger-text
    --note-modern-danger-border: $note-dark-modern-danger-border
    --note-modern-danger-bg: $note-dark-modern-danger-bg
    --note-modern-danger-text: $note-dark-modern-danger-text

    #web_bg:before
      position: absolute
      width: 100%
      height: 100%
      background:
        linear-gradient(180deg, rgba(6, 13, 34, .24) 0%, rgba(6, 13, 34, .66) 54%, rgba(6, 13, 34, .9) 100%),
        rgba(6, 13, 34, .42)
      content: ''

    .container
      code
        background: #182744

      pre > code
        background: #0c1730

      figure.highlight
        box-shadow: none

      .note
        code
          background: $code-background

      kbd
        border-color: rgba(216, 210, 195, .22)
        background-color: #14213f
        color: rgba(246, 248, 255, .9)

    // 頭部
    #page-header
      &.full_page:after,
      &.not-home-page:after,
      &.post-bg:after
        background: linear-gradient(180deg, rgba(6, 13, 34, 0), #060d22 100%)

      &.nav-fixed > #nav,
      &.not-top-img > #nav
        background: rgba(8, 17, 38, .84)
        box-shadow: 0 12px 30px -22px rgba(0, 0, 0, .68)

    #post-comment
      .comment-switch
        if hexo-config('comments.text')
          background: #2c2c2c !important

        #switch-btn
          filter: brightness(.8)

    // hide-tags
    .hide-button,
    .toggle-button,
    #post-outdate-notice,
    .error-img,
    .container iframe,
    .gist,
    .ads-wrap,
    .tag-cloud-list > a
      filter: brightness(.8)

    img:not(.cover)
      if hexo-config('lazyload.enable') && hexo-config('lazyload.blur') && !hexo-config('lazyload.placeholder')
        filter: blur(0) brightness(.88) contrast(.95)
      else
        filter: brightness(.88) contrast(.95)

    #aside-content .aside-list > .aside-list-item:not(:last-child)
      border-bottom: 1px dashed alpha(#FFFFFF, .1)

    // Gitalk
    #gitalk-container
      filter: brightness(.8)

      svg
        fill: alpha(#FFFFFF, .9) !important

    // Disqusjs 反代模式下的適配
    #disqusjs
      #dsqjs
        &:hover,
        &:focus,
        .dsqjs-tab-active,
        .dsqjs-no-comment
          color: alpha(#FFFFFF, .7)

        .dsqjs-order-label
          background-color: #101a33

        .dsqjs-post-body
          color: alpha(#FFFFFF, .7)

          code,
          pre
            background: #182744

          blockquote
            color: alpha(#FFFFFF, .7)

    #artitalk_main #lazy
      background: #101a33

    #operare_artitalk .c2
      background: #101a33

    #aside-content #card-toc
      border-color: rgba(229, 222, 204, .12)
      background: rgba(9, 16, 34, .9)
      box-shadow: 0 18px 44px rgba(0, 0, 0, .32), inset 0 0 0 1px rgba(255, 255, 255, .025)

      +maxWidth900()
        background: rgba(9, 16, 34, .94)

      .item-headline,
      .toc-percentage
        color: rgba(229, 222, 204, .68)

      .toc-content
        & > * > .toc-item > .toc-child
          border-left-color: rgba(229, 222, 204, .16)

        .toc-link
          color: rgba(198, 209, 233, .58)

          &:hover
            background: rgba(201, 216, 210, .09)
            color: rgba(246, 248, 255, .86)

          &.active
            background: rgba(201, 216, 210, .12)
            color: var(--night-accent-soft)

    #footer
      background: linear-gradient(180deg, #182744 0%, #0c1730 56%, #050a18 100%)

      &:after
        display: block
        background: linear-gradient(180deg, rgba(6, 13, 34, 0), #182744 100%)

      & > *,
      a
        color: rgba(255, 255, 255, .86)

      a:hover
        color: var(--white)

    #page-header.full_page + #content-inner
      background: #060d22
      box-shadow: 0 -24px 70px rgba(0, 0, 0, .34)

    .home-frontpage
      --home-module-surface: #101a33
      --home-module-shadow: var(--card-box-shadow)
      --home-module-hover-shadow: var(--card-hover-box-shadow)

    .home-frontpage .home-panel,
    .home-frontpage .home-panel:nth-child(2),
    .home-frontpage .home-spotlight-main,
    .home-frontpage .home-frontpage-item
      border-color: rgba(161, 177, 217, .1)
      background: rgba(16, 26, 51, .92)

    .home-frontpage .home-frontpage-actions a
      border-color: rgba(229, 222, 204, .36)
      background: rgba(255, 255, 255, .08)
      color: rgba(246, 248, 255, .9)

      &:hover
        border-color: rgba(229, 222, 204, .62)
        background: rgba(255, 255, 255, .16)
        color: #fff

    #page,
    #post,
    #tag,
    #archive,
    .home-panel,
    .home-spotlight-main,
    .home-frontpage-item,
    .posts-list-page #recent-posts > .recent-post-item
      border: 1px solid rgba(161, 177, 217, .1)
      background: rgba(16, 26, 51, .92)
      box-shadow: var(--card-box-shadow)

    #post
      border-color: rgba(229, 222, 204, .15)
      background: linear-gradient(180deg, rgba(20, 32, 61, .98) 0%, rgba(13, 24, 49, .98) 100%)
      box-shadow: 0 24px 70px rgba(0, 0, 0, .36), inset 0 0 0 1px rgba(255, 255, 255, .035)

    #article-container
      color: rgba(236, 241, 250, .9)

      p,
      li
        color: rgba(236, 241, 250, .88)

      strong,
      b
        color: rgba(246, 248, 255, .96)

      a
        color: rgba(201, 216, 210, .9)

        &:hover
          color: var(--night-accent)

      figure.highlight,
      pre
        border: 1px solid rgba(229, 222, 204, .16)
        background: #070f22
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, .04), 0 14px 34px -28px rgba(0, 0, 0, .86)

      .highlight-tools
        border-bottom: 1px solid rgba(229, 222, 204, .13)
        background: #0d1a34
        color: rgba(229, 222, 204, .76)

      code
        background: rgba(229, 222, 204, .1)
        color: rgba(246, 248, 255, .88)

    .home-frontpage .home-update-day
      background: rgba(226, 232, 247, .1)
      box-shadow: inset 0 0 0 1px rgba(161, 177, 217, .16)

      &.level-1
        background: rgba(216, 210, 195, .26)

      &.level-2
        background: rgba(216, 210, 195, .5)

      &.level-3
        background: #d8d2c3

    .home-frontpage .home-panel-head i,
    .home-frontpage .home-todo-list i
      color: var(--night-accent-soft)

    .home-frontpage .home-section-title
      border-bottom-color: rgba(216, 210, 195, .34)
      color: rgba(246, 248, 255, .9)

      &:before,
      &:after
        background: rgba(216, 210, 195, .34)

      a
        color: rgba(216, 210, 195, .82)

    .home-frontpage .home-spotlight-cover
      background: #0c1730

    .category-overview
      &__header
        border-bottom-color: rgba(161, 177, 217, .2)

      &__icon,
      &__folder
        background: rgba(229, 222, 204, .14)
        color: var(--night-accent)
        box-shadow: inset 0 0 0 1px rgba(229, 222, 204, .08)

      &__icon
        width: 62px
        height: 62px
        font-size: 1.28em

      &__folder
        width: 58px
        height: 58px
        font-size: 1em

      &__copy h2,
      &__name,
      &__child-name,
      &__count strong,
      &__child-count strong,
      &__arrow
        color: var(--night-accent)

      &__item,
      &__child
        border-color: var(--night-border)
        background: var(--night-panel-soft)
        box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .02)

        &:hover
          border-color: rgba(229, 222, 204, .28)
          box-shadow: 0 18px 40px -28px rgba(0, 0, 0, .7)

      &__children
        border-left-color: rgba(229, 222, 204, .18)

      &__child
        background: rgba(10, 18, 38, .46)

    .article-sort
      border-left-color: rgba(229, 222, 204, .34)

      &-title:after
        background: rgba(229, 222, 204, .34)

      &-title:before,
      &-item:before
        border-color: var(--night-accent)
        background: #101a33

    #nav .menus_items .nav-category-dropdown
      border-color: rgba(229, 222, 204, .14)
      background: rgba(17, 26, 45, .94)
      box-shadow: 0 20px 46px -22px rgba(0, 0, 0, .82), inset 0 0 0 1px rgba(255, 255, 255, .025)

      .nav-category-link,
      .nav-category-child-link
        color: rgba(229, 222, 204, .88) !important

        .nav-category-count,
        .nav-category-caret
          color: rgba(201, 216, 210, .58)

      & > li:not(.has-children):hover,
      & > li:not(.has-children):focus-within
        > .nav-category-link
          background: rgba(201, 216, 210, .1)
          color: rgba(246, 248, 255, .96) !important

          .nav-category-count,
          .nav-category-caret
            color: var(--night-accent-soft)

      & > li.has-children:hover,
      & > li.has-children:focus-within
        background: rgba(201, 216, 210, .08)

        > .nav-category-link,
        .nav-category-child-link
          color: rgba(246, 248, 255, .94) !important

          .nav-category-count,
          .nav-category-caret
            color: var(--night-accent-soft)

      .nav-category-children
        border-left-color: rgba(229, 222, 204, .13)

        li:hover > .nav-category-child-link
          background: rgba(229, 222, 204, .1)

    .tag-cloud-list a
      box-shadow: 0 10px 24px rgba(0, 0, 0, .22), inset 0 0 0 1px rgba(255, 255, 255, .08)

      &:hover
        background: #d8d2c3 !important
        color: #07143a !important

    // artalk
    .artalk.atk-dark-mode,
    .atk-layer-wrap.atk-dark-mode
      --at-color-font: alpha(#FFFFFF, .7)
      --at-color-meta: alpha(#FFFFFF, .7)
      --at-color-grey: alpha(#FFFFFF, .7)

    .atk-send-btn,
    .atk-badge
      color: alpha(#FFFFFF, .7) !important

    // waline
    #waline-wrap
      --waline-color: alpha(#FFFFFF, .7)
      --waline-dark-grey: alpha(#FFFFFF, .7)
      --waline-info-color: alpha(#FFFFFF, .5)
